{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cocreate",
  "main": "worker/container.js",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "CoCreateContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COCREATE_CONTAINER",
        "class_name": "CoCreateContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CoCreateContainer"]
    }
  ]
}
