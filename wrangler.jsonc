{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cocreate",
  "account_id": "fc419457dc350fcfada2b0a3f00bfe3e",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "2guys1canvas.com",
      "custom_domain": true
    },
    {
      "pattern": "www.2guys1canvas.com",
      "custom_domain": true
    }
  ],
  "main": "worker/container.js",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "COCREATE_APP_ORIGINS": "https://2guys1canvas.com",
    "COCREATE_PUBLIC_ORIGIN": "https://2guys1canvas.com",
    "COCREATE_LEGACY_ORIGIN": "https://cocreate.susan981314271.workers.dev",
    "COCREATE_WWW_ORIGIN": "https://www.2guys1canvas.com",
    "SUPABASE_ARTIFACT_BUCKET": "cocreate-artifacts",
    "SUPABASE_JWKS_URL": "https://dnsapasubeoxxsgkiotw.supabase.co/auth/v1/.well-known/jwks.json",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_3K2iwsq_nMCgBnQIqS2IUg_2_qoNjv0",
    "SUPABASE_URL": "https://dnsapasubeoxxsgkiotw.supabase.co",
    "COCREATE_RELEASE_FINGERPRINT": "8f20d8b5bd13b57f1c135696391a2bc7f17d473b29eb558b3a75f19c8fc1abaf"
  },
  "containers": [
    {
      "class_name": "CoCreateContainer",
      "image": "./Dockerfile",
      "image_vars": {
        "VITE_COCREATE_APP_ORIGIN": "https://2guys1canvas.com",
        "VITE_COCREATE_AUTH_MODE": "supabase",
        "VITE_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_3K2iwsq_nMCgBnQIqS2IUg_2_qoNjv0",
        "VITE_SUPABASE_URL": "https://dnsapasubeoxxsgkiotw.supabase.co"
      },
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COCREATE_CONTAINER",
        "class_name": "CoCreateContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CoCreateContainer"
      ]
    }
  ]
