{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cocreate",
  "main": "worker/container.js",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "SUPABASE_PUBLISHABLE_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRuc2FwYXN1YmVveHhzZ2tpb3R3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTAxODIyOTEsImV4cCI6MjEwNTc1ODI5MX0.gUDEoMSpHhtdsnXNz0oi4bDYml6Ofl5QrkxDU06nc24",
    "SUPABASE_URL": "https://dnsapasubeoxxsgkiotw.supabase.co"
  },
  "containers": [
    {
      "class_name": "CoCreateContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COCREATE_CONTAINER",
        "class_name": "CoCreateContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CoCreateContainer"]
    }
  ]
}
