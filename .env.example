PORT=5173
SESSION_SECRET=replace-with-a-long-random-value
CREDENTIAL_ENCRYPTION_SECRET=replace-with-an-independent-long-random-value
AGENT_DEBOUNCE_MS=4000
BUILD_DEBOUNCE_MS=10000
BUILD_COOLDOWN_MS=30000
BUILD_MAX_WAIT_MS=60000
COCREATE_AUTH_MODE=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
# Server-only. Never prefix with VITE_ and never commit a real value.
SUPABASE_SECRET_KEY=sb_secret_replace-me
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ARTIFACT_BUCKET=cocreate-artifacts
# Prisma runtime uses transaction mode; CLI/introspection/migrations use session mode.
# Keep real passwords server-only and percent-encode reserved URI characters.
DATABASE_URL="postgresql://postgres.your-project-ref:percent-encoded-password@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project-ref:percent-encoded-password@aws-0-your-region.pooler.supabase.com:5432/postgres"
COCREATE_APP_ORIGINS=http://localhost:5173,https://your-production-origin.example
VITE_COCREATE_AUTH_MODE=supabase
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
# Optional test-only override. Normal provider endpoints are selected in the app.
# PROVIDER_BASE_URL_OVERRIDE=http://127.0.0.1:9999/v1
