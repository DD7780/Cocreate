PORT=5173
SESSION_SECRET=replace-with-a-long-random-value
CREDENTIAL_ENCRYPTION_SECRET=replace-with-an-independent-long-random-value
AGENT_DEBOUNCE_MS=4000
BUILD_DEBOUNCE_MS=10000
BUILD_COOLDOWN_MS=30000
BUILD_MAX_WAIT_MS=60000
TWOGUYS1CANVAS_AUTH_MODE=supabase
SUPABASE_URL=https://dnsapasubeoxxsgkiotw.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_3K2iwsq_nMCgBnQIqS2IUg_2_qoNjv0
# Server-only. Never prefix with VITE_ and never commit a real value.
SUPABASE_SECRET_KEY=sb_secret_replace-me
# Server-only managed OpenRouter credential. Never prefix with VITE_.
TWOGUYS1CANVAS_MANAGED_OPENROUTER_KEY=replace-with-server-side-founder-key
SUPABASE_JWKS_URL=https://dnsapasubeoxxsgkiotw.supabase.co/auth/v1/.well-known/jwks.json
# Existing private resource ID; retain until the access-equivalent cutover in docs/harness/product-name-cleanup.md.
SUPABASE_ARTIFACT_BUCKET=cocreate-artifacts
# Hosted beta also requires the prepared migration and administrator-seeded
# owner UUID in beta_access. Never use a browser/email/VITE_* approval flag.
# Exact approval process: docs/harness/prelaunch-beta-handoff.md
# Prisma runtime uses transaction mode; CLI/introspection/migrations use session mode.
# Keep real passwords server-only and percent-encode reserved URI characters.
DATABASE_URL="postgresql://postgres.dnsapasubeoxxsgkiotw:percent-encoded-password@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.dnsapasubeoxxsgkiotw:percent-encoded-password@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"
TWOGUYS1CANVAS_APP_ORIGINS=http://localhost:5173,https://2guys1canvas.com
# Canonical public origin used to build project invitation links.
TWOGUYS1CANVAS_PUBLIC_ORIGIN=https://2guys1canvas.com
# Server-only transactional email settings. Never prefix the API key with VITE_.
RESEND_API_KEY=re_replace-me
# Use an address on the exact domain or subdomain verified in Resend, for example:
# TWOGUYS1CANVAS_EMAIL_FROM=2guys1canvas <beta@2guys1canvas.com>
TWOGUYS1CANVAS_EMAIL_FROM=
VITE_TWOGUYS1CANVAS_AUTH_MODE=supabase
# Local callback origin. Cloudflare builds override this with the canonical Worker origin through container image_vars.
VITE_TWOGUYS1CANVAS_APP_ORIGIN=http://localhost:5173
VITE_SUPABASE_URL=https://dnsapasubeoxxsgkiotw.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_3K2iwsq_nMCgBnQIqS2IUg_2_qoNjv0
# Optional test-only override. Normal provider endpoints are selected in the app.
# PROVIDER_BASE_URL_OVERRIDE=http://127.0.0.1:9999/v1

# Optional offline developer audit only. Set privately in .env.local; never VITE_*.
# AI_GATEWAY_API_KEY=
# Optional direct TypeSafe access; select with --jev-provider typesafe.
# TYPESAFE_API_KEY=
